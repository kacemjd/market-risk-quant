<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kacemrisk.market</groupId>
    <artifactId>market-risk-quant</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>market-risk-processing</artifactId>
  <name>market-risk-processing</name>
  <packaging>jar</packaging>

  <dependencies>
    <!-- Business domain -->
    <dependency>
      <groupId>com.kacemrisk.market</groupId>
      <artifactId>market-risk-business</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Workflow / pipeline orchestration -->
    <dependency>
      <groupId>com.kacemrisk.market</groupId>
      <artifactId>market-risk-workflow</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Spring Boot Web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- WebFlux — reactive WebClient for Alpha Vantage HTTP calls -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- Bean Validation (@Valid, @NotBlank, @NotNull, @DecimalMin …) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- QuestDB persistence (PG wire protocol — activated under questdb profile) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Kafka (activate via spring.kafka.bootstrap-servers) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Spark 4 — compile scope by default for local/IDE runs (Spark master = local[*]).
         Override to `provided` on a real cluster by activating the `cluster` profile.
         Exclude only log4j-slf4j2-impl to avoid SLF4J multiple-provider conflict with
         logback. log4j-core must remain: Spark loads it dynamically at runtime. -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-core_${scala.binary.version}</artifactId>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Utilities -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- OpenAPI / Swagger UI -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>local</id>
      <!-- Spring Boot local app properties -->
      <properties>
        <spring.profiles.active>local</spring.profiles.active>
      </properties>
    </profile>

    <!--
      Cluster profile — activate with -Pcluster when submitting to a real Spark cluster
      (YARN, standalone, etc.). Overrides Spark scope to `provided` because the cluster
      already ships its own Spark distribution.

      Activate explicitly:   mvn package -Pcluster
    -->
    <profile>
      <id>cluster</id>
      <dependencies>
        <!-- Override Spark scope: compile → provided for cluster submission -->
        <dependency>
          <groupId>org.apache.spark</groupId>
          <artifactId>spark-core_${scala.binary.version}</artifactId>
          <scope>provided</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.spark</groupId>
          <artifactId>spark-sql_${scala.binary.version}</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
